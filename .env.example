# ==============================================================================
# Environment Configuration Template for Indic ASR & LLM Diarization Pipeline
# Copy this file to '.env' and fill in your actual API keys.
# ==============================================================================

# -------------------------- LLM Provider (Azure OpenAI) --------------------------
LLM_PROVIDER=azure
LLM_BASE_URL=https://<your-resource-name>.openai.azure.com
LLM_MODEL=gpt-5.4-nano
LLM_API_KEY=your_azure_openai_api_key_here
LLM_AZURE_API_VERSION=2025-04-01-preview
LLM_USE_MAX_COMPLETION_TOKENS=true
LLM_REASONING_EFFORT=medium

# -------------------------- Hugging Face Access Token --------------------------
# Optional / Required if downloading gated models or Kathbath benchmarks
HF_TOKEN=your_huggingface_token_here

# -------------------------- Offline Model Path (Optional) --------------------------
# If model weights are downloaded locally (e.g., in Docker or local disk):
# INDIC_MODEL_DIR=/app/models/indic-conformer-600m
